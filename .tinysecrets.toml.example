# TinySecrets Project Configuration Example
# Copy this to .tinysecrets.toml in your project root

# Required: Your project name and environment
project = "myapp"
environment = "dev"

# Optional: Compose - List of packs to load when running commands
# If omitted, ALL packs for this project/environment are loaded
# If specified, ONLY these packs are loaded (use this for selective composition)
compose = [
    "openai",      # AI/LLM credentials
    "stripe",      # Payment provider
    "database",    # Database connection
    "redis",       # Cache connection
    "sendgrid",    # Email service
]

# Examples of different compose strategies:

# 1. Testing a new API provider variant:
#    compose = ["openai.new", "stripe", "database"]
#    (Use openai.new instead of openai to test new credentials)

# 2. Minimal compose for faster local development:
#    compose = ["database", "redis"]
#    (Only load what you need, skip external APIs)

# 3. Feature branch with experimental service:
#    compose = ["openai", "stripe", "database", "experimental.newfeature"]
#    (Add experimental packs for feature development)

# 4. Different environment setups:
#    - main branch: environment = "prod", compose = ["openai", "stripe.prod", "database"]
#    - staging branch: environment = "staging", compose = ["openai", "stripe.test", "database"]
