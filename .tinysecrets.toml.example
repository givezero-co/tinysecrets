# TinySecrets Project Configuration
# Copy this to .tinysecrets.toml in your project root

# ==============================================================================
# BASIC CONFIGURATION (Always include these)
# ==============================================================================

project = "myapp"
environment = "dev"

# ==============================================================================
# COMPOSE (Optional - controls which packs are loaded)
# ==============================================================================

compose = [
    "openai",      # AI/LLM credentials
    "stripe",      # Payment provider
    "database",    # Database connection
    "redis",       # Cache connection
    "sendgrid",    # Email service
]

# What this does:
# When you run:  ts run -- npm start
# TinySecrets will:
#   1. Load the 5 packs listed above
#   2. Decrypt all secrets from those packs
#   3. Inject them as environment variables
#   4. Run your command
#
# Example output:
#   ✓ Composed 12 secrets from 5 packs (myapp/dev)
#   [your npm start output]

# ==============================================================================
# CONFIGURATION EXAMPLES
# ==============================================================================

# -----------------------------------------------------------------------------
# Example 1: No compose (load everything)
# -----------------------------------------------------------------------------
# project = "myapp"
# environment = "dev"
# 
# # No compose field!
#
# What happens:
#   ts run -- npm start
#   → Loads ALL packs for myapp/dev (plus any flat secrets)
#   → ✓ Loaded 20 secrets from 8 packs (myapp/dev)

# -----------------------------------------------------------------------------
# Example 2: Minimal compose (local development)
# -----------------------------------------------------------------------------
# project = "myapp"
# environment = "local"
# 
# compose = [
#     "database",    # Just local postgres
#     "redis",       # Just local redis
# ]
#
# What happens:
#   ts run -- npm run dev
#   → Loads ONLY database and redis packs
#   → ✓ Composed 2 secrets from 2 packs (myapp/local)
#   → Perfect for offline development without external APIs

# -----------------------------------------------------------------------------
# Example 3: Testing new API provider variant
# -----------------------------------------------------------------------------
# project = "myapp"
# environment = "dev"
# 
# compose = [
#     "openai.new",     # Testing new credentials (variant pack)
#     "stripe",
#     "database",
# ]
#
# What happens:
#   ts run -- npm test
#   → Uses openai.new pack instead of openai
#   → Same key names (OPENAI_KEY, OPENAI_ENDPOINT) but different values
#   → ✓ Composed 5 secrets from 3 packs (myapp/dev)

# -----------------------------------------------------------------------------
# Example 4: Feature branch with experimental service
# -----------------------------------------------------------------------------
# project = "myapp"
# environment = "dev"
# 
# compose = [
#     "openai",
#     "stripe",
#     "database",
#     "analytics.posthog",    # New analytics provider (only this branch)
# ]
#
# What happens:
#   git checkout feature/add-posthog
#   ts run -- npm start
#   → Loads extra analytics.posthog pack
#   → Different .tinysecrets.toml on main branch = different packs

# -----------------------------------------------------------------------------
# Example 5: Production with monitoring
# -----------------------------------------------------------------------------
# project = "myapp"
# environment = "prod"
# 
# compose = [
#     "openai",
#     "stripe",
#     "database",
#     "redis",
#     "sendgrid",
#     "monitoring",    # Datadog, Sentry (prod only)
#     "logging",       # LogDNA, Papertrail (prod only)
# ]
#
# What happens:
#   ts run -- ./deploy.sh
#   → Loads all 7 packs from myapp/prod environment
#   → ✓ Composed 18 secrets from 7 packs (myapp/prod)
#   → Production secrets + monitoring credentials

# -----------------------------------------------------------------------------
# Example 6: A/B testing with variants
# -----------------------------------------------------------------------------
# project = "myapp"
# environment = "prod"
# 
# compose = [
#     "openai.canary",   # New OpenAI endpoint for 10% of traffic
#     "stripe",
#     "database",
# ]
#
# What happens:
#   # Main branch uses "openai" pack
#   # Canary branch uses "openai.canary" pack
#   # Deploy canary: ts run -- ./deploy.sh --target canary-servers

# ==============================================================================
# COMMON PATTERNS
# ==============================================================================

# Pattern: Per-developer customization
# Each dev can have their own local TOML (not committed)
# .gitignore: .tinysecrets.toml.local
#
# Alice's .tinysecrets.toml.local:
#   compose = ["openai.alice", "stripe.test", "database"]
#
# Bob's .tinysecrets.toml.local:
#   compose = ["openai", "stripe.test", "database"]

# Pattern: Skip expensive services locally
# compose = ["database", "redis"]
# (No external APIs - faster iteration, no API costs)

# Pattern: Different test vs integration environments
# .tinysecrets.toml (test):
#   environment = "test"
#   compose = ["database.inmemory", "redis.mock"]
#
# .tinysecrets.integration.toml (integration):
#   environment = "integration"
#   compose = ["openai", "stripe.test", "database", "redis"]

# ==============================================================================
# CLI OVERRIDES
# ==============================================================================

# You can override compose at runtime without editing this file:
#
# Add extra packs:
#   ts run --with monitoring -- npm test
#   (Loads compose packs + monitoring pack)
#
# Completely replace compose:
#   ts run --compose "openai.experimental,database" -- npm test
#   (Ignores compose in TOML, uses only these 2 packs)
#
# Override environment:
#   ts run -e prod -- ./deploy.sh
#   (Uses prod environment, ignores TOML environment)

# ==============================================================================
# GETTING STARTED
# ==============================================================================

# 1. Copy this file to .tinysecrets.toml
# 2. Update project and environment to match your setup
# 3. Start with no compose field (everything loads)
# 4. Run: ts pack group (to organize flat secrets)
# 5. Edit compose to select which packs you want
# 6. Run: ts compose show (to preview what will load)
# 7. Run: ts run -- <your-command>

# For detailed examples: docs/PACKS_EXAMPLE.md
# For TOML behavior guide: docs/TOML_CONFIG_GUIDE.md
